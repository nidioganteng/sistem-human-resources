// Salin menjadi env.php lalu isi nilai sebenarnya. JANGAN di-commit (sudah di .gitignore).
// Di server, buat file ini sekali lewat SSH/File Manager. Deploy tidak akan menimpanya.

define('APP_ENV',       'production'); // 'local' hanya untuk laptop: pesan error 500 jadi terlihat

define('DB_HOST',       '127.0.0.1');
define('DB_PORT',       '3306');
define('DB_NAME',       'u000000000_sistemhr');
define('DB_USER',       'u000000000_sistemhr');
define('DB_PASSWORD',   'ganti_password_database');

// Minimal 32 karakter acak. Buat dengan: php -r "echo bin2hex(random_bytes(32));"
define('JWT_SECRET',      'ganti_dengan_string_acak_panjang');
define('JWT_TTL_SECONDS', 28800); // 8 jam

// Berkas unggahan (KTP, CV, tanda tangan) disimpan DI LUAR public_html agar tidak bisa dibuka lewat URL.
define('STORAGE_PATH',  '/home/u000000000/hr-storage');

// Konfigurasi pengirim email (dipakai SmtpMailer di APP_ENV != 'local').
// PHP menggunakan pengaturan SMTP di php.ini; nilai di bawah hanya untuk header email.
define('MAIL_FROM',      'noreply@gaharusempana.com');
define('MAIL_FROM_NAME', 'Gaharu Sempana Group');

// Generate once: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
// Keep this key permanently; rotating it without re-encrypting makes old data unreadable.
define('DATA_ENCRYPTION_KEY', 'isi_64_karakter_hex_acak');
// Integration access is disabled while this token is empty. Use a separate random token.
define('PAYROLL_API_TOKEN', '');
